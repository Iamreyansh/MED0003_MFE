{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "required": ["environments", "mfes"],
  "properties": {
    "environments": {
      "type": "object",
      "required": ["staging", "production"],
      "additionalProperties": false,
      "properties": {
        "staging": { "$ref": "#/$defs/environment" },
        "production": { "$ref": "#/$defs/environment" }
      }
    },
    "mfes": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "name",
          "package",
          "path",
          "federationName",
          "expose",
          "port",
          "domain",
          "owner"
        ],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "package": {
            "type": "string",
            "pattern": "^@medmate/[a-z][a-z0-9-]*$"
          },
          "path": {
            "type": "string",
            "pattern": "^apps/[a-z][a-z0-9-]*$"
          },
          "federationName": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9_]*$"
          },
          "expose": { "type": "string", "const": "./Mfe" },
          "port": { "type": "integer", "minimum": 5100, "maximum": 5999 },
          "domain": {
            "type": "string",
            "pattern": "^[a-z0-9-]+\\.mfe\\.nammamedmate\\.com$"
          },
          "owner": { "type": "string", "minLength": 1 }
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "environment": {
      "type": "object",
      "required": ["name", "domainSuffix"],
      "additionalProperties": false,
      "properties": {
        "name": { "type": "string", "enum": ["staging", "production"] },
        "domainSuffix": {
          "type": "string",
          "pattern": "^[a-z0-9.-]+\\.nammamedmate\\.com$"
        }
      }
    }
  }
}
