{
  "name": "@medmate/todo",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite --port 5101 --strictPort",
    "build": "tsc -p tsconfig.app.json --noEmit && vite build",
    "preview": "vite preview --port 5101 --strictPort",
    "lint": "eslint . --max-warnings=0 --ignore-pattern dist --ignore-pattern coverage",
    "lint:fix": "eslint . --fix --ignore-pattern dist --ignore-pattern coverage",
    "typecheck": "tsc -p tsconfig.app.json --noEmit && tsc -p tsconfig.node.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@medmate/contracts": "workspace:*",
    "@medmate/mfe-kit": "workspace:*",
    "@medmate/ui": "workspace:*",
    "@reduxjs/toolkit": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "catalog:"
  },
  "devDependencies": {
    "@medmate/test-utils": "workspace:*",
    "@medmate/vite-config": "workspace:*",
    "@medmate/vitest-config": "workspace:*",
    "@module-federation/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/react": "catalog:",
    "@types/react-dom": "catalog:",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "jsdom": "catalog:",
    "typescript": "catalog:",
    "vite": "catalog:",
    "vitest": "catalog:"
  }
}
