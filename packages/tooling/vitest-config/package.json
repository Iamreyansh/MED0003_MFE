{
  "name": "@medmate/vitest-config",
  "version": "0.1.0",
  "description": "Shared Vitest configuration for MedMate packages",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "publishConfig": {
    "access": "restricted",
    "main": "./dist/index.js",
    "types": "./dist/index.d.ts",
    "exports": {
      ".": {
        "types": "./dist/index.d.ts",
        "import": "./dist/index.js"
      }
    }
  },
  "files": [
    "dist",
    "src"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "lint": "eslint src --max-warnings=0",
    "lint:fix": "eslint src --fix",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "node -e \"process.exit(0)\"",
    "test:coverage": "node -e \"process.exit(0)\""
  },
  "peerDependencies": {
    "@vitejs/plugin-react": "^4.6.0",
    "vitest": "^3.2.4"
  },
  "devDependencies": {
    "@vitejs/plugin-react": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
