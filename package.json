{
  "name": "med0003-mfe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "NammaMedMate React micro-frontend monorepo",
  "scripts": {
    "dev": "turbo run dev --filter=@medmate/todo",
    "dev:todo": "turbo run dev --filter=@medmate/todo",
    "dev:with-host": "bash scripts/dev-with-host.sh",
    "dev:all": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:todo": "turbo run build --filter=@medmate/todo",
    "preview:todo": "pnpm --filter @medmate/todo preview",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:watch": "pnpm --filter @medmate/todo exec vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "pnpm run validate:mfes && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run build",
    "create:mfe": "node tools/create-mfe/index.mjs",
    "validate:mfes": "node tools/create-mfe/validate.mjs",
    "affected": "bash scripts/affected-mfes.sh",
    "deploy:mfe": "bash scripts/deploy-mfe.sh",
    "smoke:mfe": "bash scripts/post-deploy-smoke.sh",
    "cache:pull": "bash scripts/cache-pull.sh",
    "cache:push": "bash scripts/cache-push.sh",
    "tf:lock:backup": "bash scripts/tf-lock-backup.sh",
    "tf:fmt": "terraform -chdir=infra fmt -recursive",
    "tf:init": "terraform -chdir=infra init",
    "tf:validate": "terraform -chdir=infra validate",
    "tf:plan": "terraform -chdir=infra plan",
    "tf:apply": "terraform -chdir=infra apply",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^19.8.1",
    "@eslint/js": "^9.30.1",
    "@module-federation/vite": "catalog:",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "catalog:",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "turbo": "^2.5.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
