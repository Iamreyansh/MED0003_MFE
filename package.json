{
  "name": "med0003-mfe",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "description": "NammaMedMate React micro-frontend monorepo",
  "scripts": {
    "dev": "turbo run dev --filter=@medmate/todo",
    "dev:todo": "turbo run dev --filter=@medmate/todo",
    "dev:with-host": "bash scripts/dev-with-host.sh",
    "dev:all": "turbo run dev --parallel",
    "build": "turbo run build",
    "build:todo": "turbo run build --filter=@medmate/todo",
    "preview:todo": "pnpm --filter @medmate/todo preview",
    "lint": "turbo run lint",
    "lint:fix": "turbo run lint:fix",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "test:coverage": "turbo run test:coverage",
    "test:e2e": "turbo run test:e2e --filter=./apps/*",
    "test:watch": "pnpm --filter @medmate/todo exec vitest",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "quality": "pnpm run validate:mfes && pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm run test:coverage && pnpm run test:e2e && pnpm run build",
    "create:mfe": "node tools/create-mfe/index.mjs",
    "validate:mfes": "node tools/create-mfe/validate.mjs",
    "affected": "bash scripts/affected-mfes.sh",
    "promote:mfe": "bash scripts/promote-mfe.sh",
    "smoke:mfe": "bash scripts/post-deploy-smoke.sh",
    "pdt:mfe": "bash scripts/post-deploy-pdt.sh",
    "tf:fmt": "terraform fmt -recursive infra",
    "tf:init": "terraform -chdir=infra/shared init && terraform -chdir=infra/staging init && terraform -chdir=infra/production init",
    "tf:validate": "terraform -chdir=infra/shared validate && terraform -chdir=infra/staging validate && terraform -chdir=infra/production validate",
    "tf:plan": "bash scripts/tf-plan.sh",
    "tf:apply": "bash scripts/tf-apply.sh",
    "tf:test": "terraform -chdir=infra/modules/catalog test",
    "tf:lock:backup": "bash scripts/tf-lock-backup.sh",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx,js,jsx,mjs,cjs}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{json,md,yml,yaml,css,html}": [
      "prettier --write"
    ]
  },
  "dependencies": {
    "@reduxjs/toolkit": "catalog:",
    "react": "catalog:",
    "react-dom": "catalog:",
    "react-redux": "catalog:"
  },
  "devDependencies": {
    "@commitlint/cli": "^19.8.1",
    "@commitlint/config-conventional": "^21.2.2",
    "@eslint/js": "^9.30.1",
    "@module-federation/vite": "catalog:",
    "@playwright/test": "catalog:",
    "@tailwindcss/vite": "catalog:",
    "@testing-library/dom": "catalog:",
    "@testing-library/jest-dom": "catalog:",
    "@testing-library/react": "catalog:",
    "@testing-library/user-event": "catalog:",
    "@types/node": "^26.1.1",
    "@types/react": "^18.3.23",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "catalog:",
    "@vitest/coverage-v8": "catalog:",
    "eslint": "^9.30.1",
    "eslint-config-prettier": "^10.1.5",
    "eslint-plugin-import": "^2.32.0",
    "eslint-plugin-jsx-a11y": "^6.10.2",
    "eslint-plugin-react": "^7.37.5",
    "eslint-plugin-react-hooks": "^5.2.0",
    "globals": "^16.3.0",
    "husky": "^9.1.7",
    "jsdom": "catalog:",
    "lint-staged": "^16.1.2",
    "prettier": "^3.6.2",
    "tailwindcss": "catalog:",
    "turbo": "^2.5.4",
    "typescript": "~5.8.3",
    "typescript-eslint": "^8.35.1",
    "vite": "catalog:",
    "vitest": "catalog:"
  },
  "engines": {
    "node": ">=20"
  },
  "packageManager": "pnpm@10.30.1",
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "playwright"
    ]
  }
}
